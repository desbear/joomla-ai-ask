<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="askdesk" method="upgrade">
	<name>plg_askdesk_faq</name>
	<author>GSS</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 GSS</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<version>0.6.6</version>
	<description>PLG_ASKDESK_FAQ_XML_DESCRIPTION</description>
	<namespace path="src">Gss\Plugin\Askdesk\Faq</namespace>
	<files>
		<folder plugin="faq">services</folder>
		<folder>src</folder>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/plg_askdesk_faq.ini</language>
		<language tag="en-GB">en-GB/plg_askdesk_faq.sys.ini</language>
		<language tag="zh-TW">zh-TW/plg_askdesk_faq.ini</language>
		<language tag="zh-TW">zh-TW/plg_askdesk_faq.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="group" type="text" default="" maxlength="60"
					label="PLG_ASKDESK_FAQ_GROUP" description="PLG_ASKDESK_FAQ_GROUP_DESC" hint="PLG_ASKDESK_FAQ_GROUP_HINT"/>
				<field name="catid" type="category" extension="com_content" published="1" default=""
					label="PLG_ASKDESK_FAQ_CATEGORY" description="PLG_ASKDESK_FAQ_CATEGORY_DESC">
					<option value="">PLG_ASKDESK_FAQ_CATEGORY_NONE</option>
				</field>
				<field name="language" type="contentlanguage" default="*"
					label="PLG_ASKDESK_FAQ_LANGUAGE" description="PLG_ASKDESK_FAQ_LANGUAGE_DESC">
					<option value="*">JALL</option>
				</field>
				<field name="tags_always" type="tag" mode="nested" multiple="true" custom="deny"
					label="PLG_ASKDESK_FAQ_TAGS_ALWAYS" description="PLG_ASKDESK_FAQ_TAGS_ALWAYS_DESC"/>
				<field name="tags_suggest" type="tag" mode="nested" multiple="true" custom="deny"
					label="PLG_ASKDESK_FAQ_TAGS_SUGGEST" description="PLG_ASKDESK_FAQ_TAGS_SUGGEST_DESC"/>
				<field name="state" type="list" default="0" filter="integer"
					label="PLG_ASKDESK_FAQ_STATE" description="PLG_ASKDESK_FAQ_STATE_DESC">
					<option value="0">JUNPUBLISHED</option>
					<option value="1">JPUBLISHED</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
