<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="main">
		<field name="title" type="text" required="true" maxlength="255" filter="string" label="COM_MCPASK_PET_TITLE" />
	</fieldset>
	<fields name="params">
		<fieldset name="look">
			<field name="size" type="number" default="96" min="48" max="200" filter="integer" validate="number" label="COM_MCPASK_PET_SIZE" description="COM_MCPASK_PET_SIZE_DESC" />
			<field name="mobile_size" type="number" default="72" min="40" max="160" filter="integer" validate="number" label="COM_MCPASK_PET_MOBILE_SIZE" />
			<field name="bubble" type="text" maxlength="60" filter="string" label="COM_MCPASK_PET_BUBBLE" description="COM_MCPASK_PET_BUBBLE_DESC" />
			<field name="greet_member" type="text" maxlength="80" filter="string" label="COM_MCPASK_PET_GREET_MEMBER" description="COM_MCPASK_PET_GREET_MEMBER_DESC" hint="COM_MCPASK_PET_GREET_MEMBER_HINT" />
			<field name="greet_guest" type="textarea" rows="3" filter="string" label="COM_MCPASK_PET_GREET_GUEST" description="COM_MCPASK_PET_GREET_GUEST_DESC" hint="COM_MCPASK_PET_GREET_GUEST_HINT" />
			<field name="sleep_after" type="number" default="60" min="0" max="3600" filter="integer" validate="number" label="COM_MCPASK_PET_SLEEP" description="COM_MCPASK_PET_SLEEP_DESC" />
		</fieldset>
	</fields>
</form>
